{
  "name": "ateam",
  "version": "1.0.0",
  "private": true,
  "description": "A-Team — 轻量智能体编排系统",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@8.6.8",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "pnpm build:web && pnpm build:api",
    "build:web": "vite build --config web/vite.config.ts",
    "build:api": "tsc -p tsconfig.server.json",
    "start": "node dist/server/src/index.js",
    "deploy:prod": "python3 scripts/deploy_ateam.py",
    "deploy:prod:skip-build": "python3 scripts/deploy_ateam.py --no-build",
    "deploy:bootstrap": "python3 scripts/deploy_ateam.py --bootstrap",
    "deploy:remote": "bash scripts/deploy_remote.sh",
    "deploy:smoke": "python3 scripts/smoke_test.py",
    "deploy:legacy": "python3 scripts/deploy.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tanstack/react-query": "^5.66.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.17.1",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "react-router-dom": "^6.28.1",
    "remark-gfm": "^4.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
